# Names only — never commit values. Local: copy to .env (gitignored).
# Production/previews: Netlify → Site configuration → Environment variables,
# marked "secret" and scoped to Functions. See reference.md §8.1.

# Public by design (the only VITE_ variable allowed). Previews use Turnstile's test keys.
VITE_TURNSTILE_SITE_KEY=

# Server-only (read in *.server.ts via src/lib/env.server.ts)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
